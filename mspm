#!/bin/bash

REPOS_BASE_DIR="/etc/mspm/repos"
REPOS_CONF="/etc/mspm/repos.conf"
CACHE_BASE_DIR="/etc/mspm/cache"
INSTALLED_FILE="/etc/mspm/installed"
MAKECONF_FILE="/etc/mspm/make.conf"

CLR_RESET="\033[0m"
CLR_RED="\033[1;31m"
CLR_GREEN="\033[1;32m"
CLR_YELLOW="\033[1;33m"
CLR_BLUE="\033[1;34m"
CLR_CYAN="\033[1;36m"

load_make_conf() {
    if [ -f "$MAKECONF_FILE" ]; then
        set -a
        source "$MAKECONF_FILE"
        set +a
    fi
}

get_ordered_repos() {
    if [ -f "$REPOS_CONF" ]; then
        grep -v '^[[:space:]]*#' "$REPOS_CONF" | grep -v '^[[:space:]]*$' | cut -d'=' -f1
    fi
}

find_package() {
    local target="$1"

    if [[ "$target" == *"::"* ]]; then
        local pkg_name="${target%%::*}"
        local repo_name="${target##*::}"
        if [ -f "${REPOS_BASE_DIR}/${repo_name}/${pkg_name}/mspm-build" ]; then
            echo "$repo_name"
            return 0
        fi
        return 1
    fi

    local repo
    while IFS= read -r repo; do
        if [ -n "$repo" ] && [ -f "${REPOS_BASE_DIR}/${repo}/${target}/mspm-build" ]; then
            echo "$repo"
            return 0
        fi
    done < <(get_ordered_repos)
    return 1
}

is_package_installed() {
    local target="$1"
    [ -f "$INSTALLED_FILE" ] && grep -qE "^${target}::" "$INSTALLED_FILE"
}

get_installed_package_entry() {
    local pkg_name="$1"
    if [ -f "$INSTALLED_FILE" ]; then
        grep -E "^${pkg_name}::" "$INSTALLED_FILE" | head -n 1
    fi
}

register_package() {
    local pkg_name="$1"
    local repo_name="$2"
    local version="$3"
    local full_spec="${pkg_name}::${repo_name}::${version}"

    mkdir -p "$(dirname "$INSTALLED_FILE")"
    touch "$INSTALLED_FILE"
    unregister_package "$pkg_name"
    echo "$full_spec" >> "$INSTALLED_FILE"
}

unregister_package() {
    local pkg_name="$1"
    if [ -f "$INSTALLED_FILE" ]; then
        sed -i "/^${pkg_name}::/d" "$INSTALLED_FILE"
    fi
}

get_repo_version() {
    local pkg="$1"
    local repo="$2"
    local script="${REPOS_BASE_DIR}/${repo}/${pkg}/mspm-build"
    local version=""
    if [ -f "$script" ]; then
        version=$(version="" && source "$script" &>/dev/null && echo "$version")
    fi
    echo "$version"
}

get_package_deps() {
    local pkg="$1"
    local repo="$2"
    local script="${REPOS_BASE_DIR}/${repo}/${pkg}/mspm-build"
    if [ -f "$script" ]; then
        (
            unset depends
            source "$script" &>/dev/null
            if declare -p depends &>/dev/null 2>&1; then
                printf "%s\n" "${depends[@]}"
            fi
        )
    fi
}

resolve_pkg_recursive() {
    local target="$1"
    local is_top_level="${2:-0}"

    local pkg repo
    if [[ "$target" == *"::"* ]]; then
        pkg="${target%%::*}"
        local req_repo="${target##*::}"
        repo=$(find_package "${pkg}::${req_repo}")
    else
        pkg="$target"
        repo=$(find_package "$pkg")
    fi

    if [ -z "$repo" ]; then
        echo -e "${CLR_RED}Error:${CLR_RESET} package not found in repository: ${CLR_CYAN}${target}${CLR_RESET}" >&2
        return 1
    fi

    if [ "${in_stack["$pkg"]}" = "1" ]; then
        echo -e "${CLR_RED}Error:${CLR_RESET} circular dependency detected involving ${CLR_CYAN}${pkg}${CLR_RESET}" >&2
        return 1
    fi

    if [ "${in_queue["$pkg"]}" = "1" ]; then
        return 0
    fi

    if [ "$is_top_level" -ne 1 ] && ( is_package_installed "$pkg" || [ -n "$(get_installed_package_entry "$pkg")" ] ); then
        return 0
    fi

    in_stack["$pkg"]=1

    local dep_raw
    while IFS= read -r dep_raw || [ -n "$dep_raw" ]; do
        [ -z "$dep_raw" ] && continue

        local satisfied=0
        local alt_deps
        IFS='|' read -ra alt_deps <<< "${dep_raw//||/|}"

        for alt in "${alt_deps[@]}"; do
            alt=$(echo "$alt" | xargs)
            [ -z "$alt" ] && continue

            local alt_pkg="${alt%%::*}"
            if is_package_installed "$alt_pkg" || [ -n "$(get_installed_package_entry "$alt_pkg")" ] || [ "${in_queue["$alt_pkg"]}" = "1" ]; then
                satisfied=1
                break
            fi
        done

        if [ $satisfied -eq 0 ]; then
            local available_alts=()
            for alt in "${alt_deps[@]}"; do
                alt=$(echo "$alt" | xargs)
                [ -z "$alt" ] && continue
                if [ -n "$(find_package "$alt")" ]; then
                    available_alts+=("$alt")
                fi
            done

            local dep_to_install=""
            if [ ${#available_alts[@]} -eq 0 ]; then
                echo -e "${CLR_RED}Error:${CLR_RESET} missing dependency '${CLR_CYAN}${dep_raw}${CLR_RESET}' required by '${CLR_CYAN}${pkg}${CLR_RESET}' (none of the alternatives found in repositories)." >&2
                in_stack["$pkg"]=0
                return 1
            elif [ ${#available_alts[@]} -eq 1 ]; then
                dep_to_install="${available_alts[0]}"
            else
                echo -e "${CLR_YELLOW}Multiple providers available for dependency required by ${CLR_CYAN}${pkg}${CLR_RESET}:" >&2
                for idx in "${!available_alts[@]}"; do
                    echo -e "  $((idx+1))) ${CLR_CYAN}${available_alts[$idx]}${CLR_RESET}" >&2
                done
                local choice
                while true; do
                    echo -n "Select a provider [1-${#available_alts[@]}]: " >&2
                    read -r choice < /dev/tty 2>/dev/null || read -r choice
                    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#available_alts[@]}" ]; then
                        dep_to_install="${available_alts[$((choice-1))]}"
                        break
                    else
                        echo -e "${CLR_RED}Invalid choice, try again.${CLR_RESET}" >&2
                    fi
                done
            fi

            if ! resolve_pkg_recursive "$dep_to_install" 0; then
                in_stack["$pkg"]=0
                return 1
            fi
        fi
    done < <(get_package_deps "$pkg" "$repo")

    in_stack["$pkg"]=0
    in_queue["$pkg"]=1
    resolved_list+=("${pkg}::${repo}")
    return 0
}

check_dependencies() {
    local missing=()

    if declare -p depends &> /dev/null && [ ${#depends[@]} -gt 0 ]; then
        for dep in "${depends[@]}"; do
            if [ -n "$dep" ]; then
                local satisfied=0
                IFS='|' read -ra alt_deps <<< "${dep//||/|}"
                for alt in "${alt_deps[@]}"; do
                    alt=$(echo "$alt" | xargs)
                    if [ -n "$alt" ]; then
                        if is_package_installed "$alt" || [ -n "$(get_installed_package_entry "$alt")" ]; then
                            satisfied=1
                            break
                        fi
                    fi
                done
                if [ $satisfied -eq 0 ]; then
                    missing+=("$dep")
                fi
            fi
        done
    fi

    if [ ${#missing[@]} -gt 0 ]; then
        echo -e "${CLR_RED}Error:${CLR_RESET} missing dependencies: ${CLR_CYAN}${missing[*]}${CLR_RESET}"
        return 1
    fi

    return 0
}

check_conflicts() {
    local current_pkg="$1"
    local found_conflicts=()

    if declare -p conflicts &> /dev/null && [ ${#conflicts[@]} -gt 0 ]; then
        for conf in "${conflicts[@]}"; do
            conf=$(echo "$conf" | xargs)
            if [ -n "$conf" ]; then
                if [ "$conf" != "$current_pkg" ] && ( is_package_installed "$conf" || [ -n "$(get_installed_package_entry "$conf")" ] ); then
                    found_conflicts+=("$conf")
                fi
            fi
        done
    fi

    if [ ${#found_conflicts[@]} -gt 0 ]; then
        echo -e "${CLR_RED}Error:${CLR_RESET} package conflicts with installed packages: ${CLR_YELLOW}${found_conflicts[*]}${CLR_RESET}"
        return 1
    fi

    return 0
}

prepare_build_script() {
    local package="$1"
    local repo="$2"
    local work_dir="${CACHE_BASE_DIR}/${repo}/${package}"
    local repo_script="${REPOS_BASE_DIR}/${repo}/${package}/mspm-build"
    local target_script="${work_dir}/mspm-build"

    if [ ! -f "$repo_script" ]; then
        echo -e "${CLR_RED}Error:${CLR_RESET} build script for ${CLR_CYAN}${package}${CLR_RESET} not found in repository ${CLR_YELLOW}${repo}${CLR_RESET}."
        return 1
    fi

    mkdir -p "$work_dir"
    cp "$repo_script" "$target_script"
    cd "$work_dir" || exit 1
    return 0
}

sync_repo() {
    if [ ! -f "$REPOS_CONF" ]; then
        echo -e "${CLR_RED}Error:${CLR_RESET} ${REPOS_CONF} not found."
        exit 1
    fi

    mkdir -p "$REPOS_BASE_DIR"

    while IFS='=' read -r repo_name sync_cmd || [ -n "$repo_name" ]; do
        [[ "$repo_name" =~ ^[[:space:]]*# ]] && continue
        [[ -z "$repo_name" ]] && continue

        repo_name=$(echo "$repo_name" | xargs)
        sync_cmd=$(echo "$sync_cmd" | xargs)

        if [ -n "$repo_name" ] && [ -n "$sync_cmd" ]; then
            echo -e "Synchronizing repository: ${CLR_YELLOW}${repo_name}${CLR_RESET}..."
            local repo_dir="${REPOS_BASE_DIR}/${repo_name}"

            rm -rf "$repo_dir"
            mkdir -p "$repo_dir"

            (cd "$repo_dir" && eval "$sync_cmd")
            if [ $? -eq 0 ]; then
                echo -e "${CLR_GREEN}Repository ${CLR_YELLOW}${repo_name}${CLR_GREEN} successfully synchronized.${CLR_RESET}"
            else
                echo -e "${CLR_RED}Error: failed to synchronize repository ${CLR_YELLOW}${repo_name}${CLR_RED}.${CLR_RESET}"
            fi
        fi
    done < "$REPOS_CONF"
}

process_install_list() {
    local targets=("$@")
    local resolved_list=()
    local -A in_stack=()
    local -A in_queue=()

    for item in "${targets[@]}"; do
        if ! resolve_pkg_recursive "$item" 1; then
            exit 1
        fi
    done

    if [ ${#resolved_list[@]} -eq 0 ]; then
        echo -e "${CLR_GREEN}All requested packages (and their dependencies) are already installed.${CLR_RESET}"
        return 0
    fi

    if [ "${SKIP_CONFIRM}" != "1" ]; then
        echo -e "Packages to install:"
        for spec in "${resolved_list[@]}"; do
            pkg="${spec%%::*}"
            repo="${spec##*::}"
            ver=$(get_repo_version "$pkg" "$repo")
            echo -e "  - ${CLR_CYAN}${pkg}${CLR_RESET}${CLR_YELLOW}::${repo}${CLR_RESET} ${CLR_BLUE}(version: ${ver:-unknown})${CLR_RESET}"
        done
        echo

        read -p "$(echo -e "Proceed with installation? (${CLR_GREEN}y${CLR_RESET}/${CLR_RED}n${CLR_RESET}): ")" -r REPLY
        echo

        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            echo "Installation cancelled."
            exit 0
        fi
    fi

    for spec in "${resolved_list[@]}"; do
        pkg="${spec%%::*}"
        repo="${spec##*::}"

        if prepare_build_script "$pkg" "$repo"; then
            work_dir="${CACHE_BASE_DIR}/${repo}/${pkg}"
            script_file="${work_dir}/mspm-build"

            version=""
            unset depends conflicts
            source "$script_file"
            set +e

            if ! check_dependencies; then
                exit 1
            fi

            if ! check_conflicts "$pkg"; then
                exit 1
            fi

            if declare -f install &> /dev/null; then
                echo -e "Executing install function for ${CLR_CYAN}${pkg}${CLR_RESET}${CLR_YELLOW}::${repo}${CLR_RESET}..."
                ( set -e; install )
                if [ $? -eq 0 ]; then
                    register_package "$pkg" "$repo" "$version"
                    echo -e "${CLR_GREEN}Successfully installed ${CLR_CYAN}${pkg}${CLR_RESET}${CLR_YELLOW}::${repo}${CLR_RESET}"
                else
                    echo -e "${CLR_RED}Install function failed for ${CLR_CYAN}${pkg}${CLR_RESET}${CLR_YELLOW}::${repo}${CLR_RESET}"
                    exit 1
                fi
            else
                echo -e "${CLR_RED}Error: 'install' function not found in build script.${CLR_RESET}"
                exit 1
            fi
        else
            exit 1
        fi
    done
}

process_remove_list() {
    local targets=("$@")
    local resolved=()

    for item in "${targets[@]}"; do
        if [[ "$item" == *"::"* ]]; then
            pkg_name="${item%%::*}"
            full_spec=$(get_installed_package_entry "$pkg_name")
        else
            full_spec=$(get_installed_package_entry "$item")
        fi

        if [ -z "$full_spec" ]; then
            echo -e "${CLR_RED}Package ${CLR_CYAN}$item${CLR_RED} is not installed, cannot remove.${CLR_RESET}"
            exit 1
        fi

        resolved+=("$full_spec")
    done

    echo -e "Packages to remove:"
    for spec in "${resolved[@]}"; do
        pkg="${spec%%::*}"
        rest="${spec#*::}"
        repo="${rest%%::*}"
        ver="${rest#*::}"
        echo -e "  - ${CLR_CYAN}${pkg}${CLR_RESET}${CLR_YELLOW}::${repo}${CLR_RESET} ${CLR_BLUE}(version: ${ver:-unknown})${CLR_RESET}"
    done
    echo

    read -p "$(echo -e "Proceed with removal? (${CLR_GREEN}y${CLR_RESET}/${CLR_RED}n${CLR_RESET}): ")" -r REPLY
    echo

    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "Removal cancelled."
        exit 0
    fi

    for spec in "${resolved[@]}"; do
        pkg="${spec%%::*}"
        rest="${spec#*::}"
        repo="${rest%%::*}"
        ver="${rest#*::}"

        if prepare_build_script "$pkg" "$repo"; then
            work_dir="${CACHE_BASE_DIR}/${repo}/${pkg}"
            script_file="${work_dir}/mspm-build"

            source "$script_file"
            set +e

            if declare -f remove &> /dev/null; then
                echo -e "Executing remove function for ${CLR_CYAN}${pkg}${CLR_RESET}${CLR_YELLOW}::${repo}${CLR_RESET}..."
                ( set -e; remove )
                if [ $? -eq 0 ]; then
                    unregister_package "$pkg"
                    cd /tmp || exit 1
                    rm -rf "$work_dir"
                    echo -e "${CLR_GREEN}Successfully removed ${CLR_CYAN}${pkg}${CLR_RESET}${CLR_YELLOW}::${repo}${CLR_RESET}"
                else
                    echo -e "${CLR_RED}Remove function failed for ${CLR_CYAN}${pkg}${CLR_RESET}${CLR_YELLOW}::${repo}${CLR_RESET}"
                    exit 1
                fi
            else
                echo -e "${CLR_RED}Error: 'remove' function not found in build script.${CLR_RESET}"
                exit 1
            fi
        else
            exit 1
        fi
    done
}

process_update() {
    if [ ! -f "$INSTALLED_FILE" ]; then
        echo -e "${CLR_YELLOW}No installed packages found.${CLR_RESET}"
        return 0
    fi

    local updates_to_pkg=()
    local updates_to_repo=()
    local updates_old_ver=()
    local updates_new_ver=()

    while IFS= read -r entry || [ -n "$entry" ]; do
        [ -z "$entry" ] && continue
        pkg="${entry%%::*}"
        rest="${entry#*::}"
        repo="${rest%%::*}"
        inst_ver="${rest#*::}"

        local repo_ver
        repo_ver=$(get_repo_version "$pkg" "$repo")

        if [ -n "$repo_ver" ] && [ "$inst_ver" != "$repo_ver" ]; then
            updates_to_pkg+=("$pkg")
            updates_to_repo+=("$repo")
            updates_old_ver+=("${inst_ver:-unknown}")
            updates_new_ver+=("$repo_ver")
        fi
    done < "$INSTALLED_FILE"

    if [ ${#updates_to_pkg[@]} -eq 0 ]; then
        echo -e "${CLR_GREEN}All packages are up to date.${CLR_RESET}"
        return 0
    fi

    echo -e "Available updates:"
    for (( i=0; i<${#updates_to_pkg[@]}; i++ )); do
        echo -e "  - ${CLR_CYAN}${updates_to_pkg[$i]}${CLR_RESET}${CLR_YELLOW}::${updates_to_repo[$i]}${CLR_RESET} [${CLR_RED}${updates_old_ver[$i]}${CLR_RESET} -> ${CLR_GREEN}${updates_new_ver[$i]}${CLR_RESET}]"
    done
    echo

    read -p "$(echo -e "Proceed with update? (${CLR_GREEN}y${CLR_RESET}/${CLR_RED}n${CLR_RESET}): ")" -r REPLY
    echo

    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "Update cancelled."
        exit 0
    fi

    SKIP_CONFIRM=1
    for (( i=0; i<${#updates_to_pkg[@]}; i++ )); do
        local pkg="${updates_to_pkg[$i]}"
        local repo="${updates_to_repo[$i]}"

        echo -e "Updating ${CLR_CYAN}${pkg}${CLR_RESET}${CLR_YELLOW}::${repo}${CLR_RESET}..."
        process_install_list "${pkg}::${repo}"
    done
    unset SKIP_CONFIRM
}

process_search() {
    local query="$1"
    local found=0

    while IFS= read -r repo; do
        [ -z "$repo" ] && continue
        local repo_dir="${REPOS_BASE_DIR}/${repo}"

        if [ -d "$repo_dir" ]; then
            while IFS= read -r script_path; do
                [ -z "$script_path" ] && continue
                local pkg_dir
                pkg_dir=$(dirname "$script_path")
                local pkg_name
                pkg_name=$(basename "$pkg_dir")

                if [ -z "$query" ] || [[ "$pkg_name" == *"$query"* ]]; then
                    local ver
                    ver=$(get_repo_version "$pkg_name" "$repo")
                    local installed_mark=""

                    if is_package_installed "$pkg_name"; then
                        installed_mark=" ${CLR_GREEN}[installed]${CLR_RESET}"
                    fi

                    echo -e "* ${CLR_CYAN}${pkg_name}${CLR_RESET}${CLR_YELLOW}::${repo}${CLR_RESET} ${CLR_BLUE}(version: ${ver:-unknown})${CLR_RESET}${installed_mark}"
                    found=1
                fi
            done < <(find "$repo_dir" -mindepth 2 -maxdepth 2 -name "mspm-build" 2>/dev/null)
        fi
    done < <(get_ordered_repos)

    if [ $found -eq 0 ]; then
        if [ -n "$query" ]; then
            echo -e "${CLR_YELLOW}No packages matching '${query}' found.${CLR_RESET}"
        else
            echo -e "${CLR_YELLOW}No packages available in repositories.${CLR_RESET}"
        fi
    fi
}

process_list() {
    if [ ! -f "$INSTALLED_FILE" ] || [ ! -s "$INSTALLED_FILE" ]; then
        echo -e "${CLR_YELLOW}No installed packages.${CLR_RESET}"
        return 0
    fi

    echo -e "Installed packages:"
    while IFS= read -r entry || [ -n "$entry" ]; do
        [ -z "$entry" ] && continue
        pkg="${entry%%::*}"
        rest="${entry#*::}"
        repo="${rest%%::*}"
        ver="${rest#*::}"

        echo -e "  - ${CLR_CYAN}${pkg}${CLR_RESET}${CLR_YELLOW}::${repo}${CLR_RESET} ${CLR_BLUE}(version: ${ver:-unknown})${CLR_RESET}"
    done < "$INSTALLED_FILE"
}

load_make_conf

ACTION="$1"
shift

if [ "$ACTION" = "sync" ]; then
    sync_repo
    exit 0

elif [ "$ACTION" = "install" ] && [ $# -gt 0 ]; then
    if [ ! -d "$REPOS_BASE_DIR" ]; then
        echo -e "${CLR_RED}Repositories directory not found at ${REPOS_BASE_DIR}. Run 'mspm sync' first.${CLR_RESET}"
        exit 1
    fi
    process_install_list "$@"

elif [ "$ACTION" = "remove" ] && [ $# -gt 0 ]; then
    if [ ! -d "$REPOS_BASE_DIR" ]; then
        echo -e "${CLR_RED}Repositories directory not found at ${REPOS_BASE_DIR}. Run 'mspm sync' first.${CLR_RESET}"
        exit 1
    fi
    process_remove_list "$@"

elif [ "$ACTION" = "update" ]; then
    if [ ! -d "$REPOS_BASE_DIR" ]; then
        echo -e "${CLR_RED}Repositories directory not found at ${REPOS_BASE_DIR}. Run 'mspm sync' first.${CLR_RESET}"
        exit 1
    fi
    process_update

elif [ "$ACTION" = "search" ]; then
    if [ ! -d "$REPOS_BASE_DIR" ]; then
        echo -e "${CLR_RED}Repositories directory not found at ${REPOS_BASE_DIR}. Run 'mspm sync' first.${CLR_RESET}"
        exit 1
    fi
    process_search "$1"

elif [ "$ACTION" = "list" ]; then
    process_list

else
    echo "Usage:"
    echo "  mspm sync"
    echo "  mspm install <pkg-1>[::repo]..."
    echo "  mspm remove <pkg-1>[::repo]..."
    echo "  mspm update"
    echo "  mspm search [query]"
    echo "  mspm list"
    exit 1
fi
